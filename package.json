{
  "name": "remotepad2",
  "private": true,
  "version": "0.1.0-nightly.20261126",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @remotepad2/server --filter @remotepad2/web dev",
    "build": "pnpm typecheck && pnpm --filter @remotepad2/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "start": "pnpm --filter @remotepad2/server start",
    "gateway": "apps/server/node_modules/.bin/tsx apps/server/src/lane-cli.ts gateway",
    "lanes": "apps/server/node_modules/.bin/tsx apps/server/src/lane-cli.ts",
    "test": "apps/server/node_modules/.bin/tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:gateway": "E2E_GATEWAY=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "remotepad2Build": {
    "source": "6eb0e4dfae48fa3251259a569dede4a7d5d12b86",
    "date": "20261126"
  }
}
